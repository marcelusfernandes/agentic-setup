{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["hooks/**/*.mjs", "ci/**/*.mjs", "scripts/**/*.mjs", "tests/**/*.mjs"]
}
