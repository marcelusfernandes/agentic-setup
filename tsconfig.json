{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["hooks/**/*.mts", "ci/**/*.mts", "scripts/**/*.mts", "tests/**/*.mts"]
}
